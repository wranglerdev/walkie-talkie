{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "migrate:local": "node --experimental-strip-types scripts/db-migrate.ts --local && node --experimental-strip-types scripts/auth-migrate.ts --local",
    "migrate:remote": "node --experimental-strip-types scripts/db-migrate.ts --remote && node --experimental-strip-types scripts/auth-migrate.ts --remote",
    "db:migrate:local": "node --experimental-strip-types scripts/db-migrate.ts --local",
    "db:migrate:remote": "node --experimental-strip-types scripts/db-migrate.ts --remote",
    "auth:migrate:local": "node --experimental-strip-types scripts/auth-migrate.ts --local",
    "auth:migrate:remote": "node --experimental-strip-types scripts/auth-migrate.ts --remote",
    "seed:local": "node --experimental-strip-types scripts/db-seed.ts --local",
    "seed:remote": "node --experimental-strip-types scripts/db-seed.ts --remote"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@walkie-talkie/shared": "*",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "openai": "^6.39.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@cloudflare/workers-types": "^4.20260523.1",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.7",
    "wrangler": "^4.4.0"
  }
}
