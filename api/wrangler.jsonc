{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walkie-talkie-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "USER_TIMEZONE": "America/Sao_Paulo"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "walkie-talkie-db",
      "database_id": "de882c2b-7489-4c38-aaa3-687f73b348bc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "walkie-talkie-audio"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "queue": "item-auto-confirm",
        "binding": "ITEM_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "item-auto-confirm",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
