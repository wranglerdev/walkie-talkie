{
	"name": "walkie-talkie",
	"main": "worker/index.ts",
	"compatibility_date": "2026-05-26",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"services": [
		{
			"binding": "API",
			"service": "walkie-talkie-api"
		}
	],
	"observability": {
		"enabled": true
	}
}
